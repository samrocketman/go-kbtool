<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kbtool message board — {{fmtTime .GeneratedAt}}</title>
<style>
body{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;margin:2rem auto;max-width:1100px;padding:0 1rem;color:#222}
h1{margin:0 0 .2rem}
.meta{color:#666;margin:0 0 1rem}
.toolbar{position:sticky;top:0;z-index:1;background:#fff;padding:.5rem 0;border-bottom:1px solid #ddd;margin-bottom:1rem}
.toolbar input{width:320px;padding:.3rem}
.toolbar button{margin-left:.4rem}
#shown{margin-left:.6rem;color:#666}
details.section,details.thread{border:1px solid #ccc;border-radius:6px;margin-bottom:1rem;padding:.4rem .8rem}
details.section>summary,details.thread>summary{font-size:1.2rem;font-weight:600;cursor:pointer}
details.msg{border-left:3px solid #9ab;margin:.5rem 0 .5rem .5rem;padding:.2rem .6rem;background:#fafbfc}
details.msg.untrusted{border-left-color:#c33;background:#fff5f5}
details.msg>summary{cursor:pointer}
details.msg[open] .preview{display:none}
pre{white-space:pre-wrap;word-break:break-word;background:#f3f3f3;padding:.6rem;border-radius:4px;margin:.4rem 0}
details.blob pre{max-height:200px;overflow:auto;word-break:break-all;font-size:.75rem}
details.blob>summary{cursor:pointer;color:#555}
table.roster{border-collapse:collapse;margin:.5rem 0}
table.roster th,table.roster td{border:1px solid #ddd;padding:.25rem .6rem;text-align:left}
.seq{color:#888}
.ts{color:#555;font-family:monospace}
.count{color:#777;font-weight:400;font-size:.9rem}
.kind{padding:0 .4rem;border-radius:3px;background:#e4e8ef;font-size:.85rem}
.k-task{background:#ffe9b3}
.k-result{background:#cdeccd}
.k-hello{background:#dbe7ff}
.k-feature{background:#f0dcff}
.badge,.state{font-size:.8rem;padding:0 .4rem;border-radius:3px}
.ok,.active{background:#d4f5d4;color:#165016}
.bad{background:#f8d0d0;color:#7a1010;font-weight:600}
.stale{background:#eee;color:#555}
.task,.refs{font-size:.85rem;color:#445}
.preview{color:#666}
.empty{color:#777;font-style:italic}
.has-attach{font-size:.8rem;padding:0 .4rem;border-radius:3px;background:#e6f0e6}
details.attach{margin:.4rem 0}
details.attach>summary{cursor:pointer;color:#355}
table.files{border-collapse:collapse;margin:.3rem 0;font-size:.85rem}
table.files td{border:1px solid #ddd;padding:.15rem .5rem;font-family:monospace}
table.files td.size{text-align:right}
.hint{font-size:.85rem;color:#555}
</style>
</head>
<body>
<h1>kbtool message board</h1>
<p class="meta">Exported {{fmtTime .GeneratedAt}} by {{.Server}} · {{len .Threads}} thread(s) · {{msgCount .}} message(s) · ACTIVE = last seen within {{.TTL}}s of the export</p>
<div class="toolbar">
<input id="q" type="search" placeholder="Filter messages (author, kind, text)…" autocomplete="off">
<button type="button" id="expand">Expand all</button>
<button type="button" id="collapse">Collapse all</button>
<span id="shown"></span>
</div>
<details class="section" open>
<summary>Agents <span class="count">{{len .Agents}}</span></summary>
{{- if .Agents}}
<table class="roster">
<thead><tr><th>Agent</th><th>State</th><th>Posts</th><th>First seen</th><th>Last seen</th></tr></thead>
<tbody>
{{- range .Agents}}
<tr><td>{{.ID}}</td><td>{{if .Active}}<span class="state active">ACTIVE</span>{{else}}<span class="state stale">STALE</span>{{end}}</td><td>{{.Posts}}</td><td class="ts">{{fmtTime .FirstSeen}}</td><td class="ts">{{fmtTime .LastSeen}}</td></tr>
{{- end}}
</tbody>
</table>
{{- else}}
<p class="empty">No agents have signed up yet.</p>
{{- end}}
</details>
{{- range .Threads}}
{{- $tid := .ID}}
<details class="thread" id="thread-{{.ID}}" open>
<summary>{{.ID}} <span class="count">{{len .Msgs}} message(s) · created {{fmtTime .CreatedAt}} by {{.CreatedBy}}</span></summary>
{{- range .Msgs}}
<details class="msg{{if ne .Status "verified"}} untrusted{{end}}" data-search="{{searchText .}}">
<summary><span class="seq">#{{.Seq}}</span> <span class="ts">{{fmtTime .At}}</span> <b>{{.Agent}}</b> <span class="kind k-{{.Kind}}">{{.Kind}}</span> <span class="badge {{statusClass .Status}}">{{.Status}}</span>
{{- if .Task}} <span class="task">task: {{.Task}}</span>{{end}}
{{- if .Refs}} <span class="refs">refs: {{join .Refs ", "}}</span>{{end}}
{{- if .Attach}} <span class="has-attach">attachment: {{len .Attach.Files}} file(s)</span>{{end}} <span class="preview">{{preview .Text}}</span></summary>
{{- range segments .Text}}
{{- if .Blob}}
<details class="blob"><summary>base64 attachment ({{len .Text}} chars)</summary><pre>{{.Text}}</pre></details>
{{- else}}
<pre>{{.Text}}</pre>
{{- end}}
{{- end}}
{{- $seq := .Seq}}
{{- with .Attach}}
<details class="attach"><summary>attachment: {{len .Files}} file(s) · {{.Size}} bytes compressed · sha256 {{.SHA256}}</summary>
<table class="files"><tbody>
{{- range .Files}}
<tr><td class="size">{{.Size}}</td><td>{{.Name}}</td></tr>
{{- end}}
</tbody></table>
{{- if .Data}}
<p class="hint"><a download="{{$tid}}-{{$seq}}.tar.gz" href="{{dataURL .Data}}">Download {{$tid}}-{{$seq}}.tar.gz</a> (embedded; check it with <code>sha256sum</code> against the digest above), or retrieve it with <code>kbtool board fetch {{$tid}}#{{$seq}}</code>.</p>
{{- else}}
<p class="hint">Not embedded (1 MiB or larger). Retrieve and extract it with kbtool, which verifies the digest and never overwrites files:</p>
<pre>kbtool board fetch -o {{$tid}}-{{$seq}} {{$tid}}#{{$seq}}</pre>
{{- end}}
</details>
{{- end}}
</details>
{{- else}}
<p class="empty">No messages.</p>
{{- end}}
</details>
{{- end}}
<script>
(function () {
  var q = document.getElementById('q');
  var shown = document.getElementById('shown');
  var msgs = Array.prototype.slice.call(document.querySelectorAll('details.msg'));
  function setAll(open) {
    document.querySelectorAll('details.section, details.thread, details.msg').forEach(function (d) { d.open = open; });
  }
  function filter() {
    var term = q.value.trim().toLowerCase();
    var n = 0;
    msgs.forEach(function (d) {
      var hit = !term || d.getAttribute('data-search').indexOf(term) !== -1;
      d.hidden = !hit;
      if (hit) { n++; }
    });
    shown.textContent = term ? n + ' of ' + msgs.length + ' message(s) match' : '';
  }
  document.getElementById('expand').addEventListener('click', function () { setAll(true); });
  document.getElementById('collapse').addEventListener('click', function () { setAll(false); });
  q.addEventListener('input', filter);
})();
</script>
</body>
</html>
